# Copy to .env (or run `python scripts/make_env.py`, which generates random secrets).
# Never commit .env.

DEBUG=True
SECRET_KEY=change-me
AUTH_PEPPER=change-me-too
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL 8+)
DB_ENGINE=mysql
DB_NAME=secure_auth
DB_USER=secure_auth
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
COOKIE_SECURE=False

# WebAuthn: RP ID must be the site's effective domain (no scheme/port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Secure Auth
WEBAUTHN_ORIGINS=http://localhost:5173

# Policy
OTP_TTL_SECONDS=300
LOCKOUT_MAX_FAILURES=5
LOCKOUT_DURATION_SECONDS=3600

# Email (console backend prints the code in the server terminal in DEBUG)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# SMS: console (dev) or twilio
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Production: shared cache for rate limits / cooldowns
# REDIS_URL=redis://127.0.0.1:6379/1
# TRUST_PROXY=True
